@namespace RCA_StudyManagementSystem.Shared.Layout
@using Microsoft.JSInterop
@using MudBlazor
@using System.Security.Claims
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<div class="sidebar @(isCollapsed ? "collapsed" : "")">
    <div class="top-row navbar">
        <div class="container-fluid sidebar-header">
            <img src="rca_logo.png" class="rca-logo" alt="RCA Logo" />

            <button class="menu-toggle-btn" @onclick="ToggleMenu" title="Toggle menu">
                <MudIcon Icon="@(isCollapsed ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)" />
            </button>
        </div>
    </div>

    <div class="nav-scrollable">
        <nav class="flex-column">

            <div class="nav-item">
                <NavLink class="nav-link" href="/app" Match="NavLinkMatch.All" style="color: white;">
                    <MudIcon Icon="@Icons.Material.Filled.Home" Class="nav-icon mr-2" />
                    <span class="nav-text">Home</span>
                </NavLink>
            </div>

            @if (isAdmin || isUser)
            {
                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleCasesClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.Note" Class="nav-icon mr-2" />
                        <span class="nav-text">Cases</span>
                    </a>
                </div>

                @if (expandCases)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/cases/create" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Class="nav-icon mr-2" />
                                <span class="nav-text">Create Case</span>
                            </NavLink>
                        </div>

                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/cases/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.Note" Class="nav-icon mr-2" />
                                <span class="nav-text">Manage Cases</span>
                            </NavLink>
                        </div>
                    </div>
                }

                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleStudiesClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.Hive" Class="nav-icon mr-2" />
                        <span class="nav-text">Studies</span>
                    </a>
                </div>

                @if (expandStudies)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/studies/create" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Class="nav-icon mr-2" />
                                <span class="nav-text">Create Study</span>
                            </NavLink>
                        </div>

                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/studies/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.Hive" Class="nav-icon mr-2" />
                                <span class="nav-text">Manage Studies</span>
                            </NavLink>
                        </div>
                    </div>
                }

                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleExportsClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Class="nav-icon mr-2" />
                        <span class="nav-text">Exports</span>
                    </a>
                </div>

                @if (expandExports)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/exports/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Class="nav-icon mr-2" />
                                <span class="nav-text">Current Exports</span>
                            </NavLink>
                        </div>

                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/exports/pastlist" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Class="nav-icon mr-2" />
                                <span class="nav-text">Past Exports</span>
                            </NavLink>
                        </div>
                    </div>
                }

                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleListingsClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Class="nav-icon mr-2" />
                        <span class="nav-text">Lists</span>
                    </a>
                </div>

                @if (expandListings)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/lookups/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.ListAlt" Class="nav-icon mr-2" />
                                <span class="nav-text">Manage Lookups</span>
                            </NavLink>
                        </div>

                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/histologies/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.ListAlt" Class="nav-icon mr-2" />
                                <span class="nav-text">Manage Histologies</span>
                            </NavLink>
                        </div>
                    </div>
                }
            }

            @if (isAdmin || isUser || isBusiness)
            {
                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleReportsClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Class="nav-icon mr-2" />
                        <span class="nav-text">Reports</span>
                    </a>
                </div>

                @if (expandReports)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/reports/pathsbystudybydate" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Class="nav-icon mr-2" />
                                <span class="nav-text">Path Counts</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/reports/cecspathcaserace" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Class="nav-icon mr-2" />
                                <span class="nav-text">CECS Path Case Race</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/reports/pathsubmissions" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Class="nav-icon mr-2" />
                                <span class="nav-text">Path Submission Entry</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/reports/participantstatus" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Class="nav-icon mr-2" />
                                <span class="nav-text">Participant Status</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/reports/ccrsummary" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Class="nav-icon mr-2" />
                                <span class="nav-text">CCR Summary</span>
                            </NavLink>
                        </div>
                    </div>
                }

                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleHospitalsClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Class="nav-icon mr-2" />
                        <span class="nav-text">Hospitals</span>
                    </a>
                </div>

                @if (expandHospitals)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/hospitals/create" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Class="nav-icon mr-2" />
                                <span class="nav-text">Create Hospital</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/hospitals/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Class="nav-icon mr-2" />
                                <span class="nav-text">Manage Hospitals</span>
                            </NavLink>
                        </div>
                    </div>
                }

                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleDoctorsClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Class="nav-icon mr-2" />
                        <span class="nav-text">Doctors</span>
                    </a>
                </div>

                @if (expandDoctors)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/doctors/create" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Class="nav-icon mr-2" />
                                <span class="nav-text">Create Doctor</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/doctors/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Class="nav-icon mr-2" />
                                <span class="nav-text">Manage Doctors</span>
                            </NavLink>
                        </div>
                    </div>
                }

                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleReimbursementEntitiesClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="nav-icon mr-2" />
                        <span class="nav-text">Reimbursement Entities</span>
                    </a>
                </div>

                @if (expandReimbursementEntities)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/reimbursemententities/create" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Class="nav-icon mr-2" />
                                <span class="nav-text">Create Reimb. Entity</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/reimbursemententities/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="nav-icon mr-2" />
                                <span class="nav-text">Manage Reimb. Entities</span>
                            </NavLink>
                        </div>
                    </div>
                }

                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleRCAContactsClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.Contacts" Class="nav-icon mr-2" />
                        <span class="nav-text">RCA Contacts</span>
                    </a>
                </div>

                @if (expandRCAContacts)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/rcacontacts/create" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Class="nav-icon mr-2" />
                                <span class="nav-text">Create RCA Contact</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/rcacontacts/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.Contacts" Class="nav-icon mr-2" />
                                <span class="nav-text">Manage RCA Contacts</span>
                            </NavLink>
                        </div>
                    </div>
                }

                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleInvoicesClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="nav-icon mr-2" />
                        <span class="nav-text">Invoices</span>
                    </a>
                </div>

                @if (expandInvoices)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/invoices/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="nav-icon mr-2" />
                                <span class="nav-text">Current Invoices</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/invoices/pastlist" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="nav-icon mr-2" />
                                <span class="nav-text">Past Invoices</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/invoices/tracking" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="nav-icon mr-2" />
                                <span class="nav-text">Tracking</span>
                            </NavLink>
                        </div>
                    </div>
                }

                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleDoNotContactsClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.DoNotDisturbAlt" Class="nav-icon mr-2" />
                        <span class="nav-text">Do Not Contact</span>
                    </a>
                </div>

                @if (expandDoNotContacts)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/donotcontact/create" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Class="nav-icon mr-2" />
                                <span class="nav-text">Create Do Not Contact</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/donotcontact/list" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.DoNotDisturbAlt" Class="nav-icon mr-2" />
                                <span class="nav-text">Manage Do Not Contact</span>
                            </NavLink>
                        </div>
                    </div>
                }

                <div class="nav-item">
                    <a class="nav-link" href="javascript:void(0)" @onclick="HandleArchivesClick" style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.Archive" Class="nav-icon mr-2" />
                        <span class="nav-text">Archives</span>
                    </a>
                </div>

                @if (expandArchives)
                {
                    <div class="sub-menu">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/archives/studies" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.Archive" Class="nav-icon mr-2" />
                                <span class="nav-text">Archived Studies</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="app/archives/cases" style="color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.Archive" Class="nav-icon mr-2" />
                                <span class="nav-text">Archived Cases</span>
                            </NavLink>
                        </div>
                    </div>
                }
            }
        </nav>
    </div>
</div>

@code {
    private bool isCollapsed;

    private bool expandCases;
    private bool expandStudies;
    private bool expandListings;
    private bool expandHospitals;
    private bool expandDoctors;
    private bool expandExports;
    private bool expandDoNotContacts;
    private bool expandArchives;
    private bool expandReimbursementEntities;
    private bool expandRCAContacts;
    private bool expandInvoices;
    private bool expandReports;

    private bool isAdmin;
    private bool isBusiness;
    private bool isUser;
    private ClaimsPrincipal? user;

    private void ToggleMenu() => isCollapsed = !isCollapsed;

    private void HandleCasesClick() => expandCases = !expandCases;
    private void HandleStudiesClick() => expandStudies = !expandStudies;
    private void HandleExportsClick() => expandExports = !expandExports;
    private void HandleListingsClick() => expandListings = !expandListings;
    private void HandleHospitalsClick() => expandHospitals = !expandHospitals;
    private void HandleDoctorsClick() => expandDoctors = !expandDoctors;
    private void HandleDoNotContactsClick() => expandDoNotContacts = !expandDoNotContacts;
    private void HandleArchivesClick() => expandArchives = !expandArchives;
    private void HandleReimbursementEntitiesClick() => expandReimbursementEntities = !expandReimbursementEntities;
    private void HandleRCAContactsClick() => expandRCAContacts = !expandRCAContacts;
    private void HandleInvoicesClick() => expandInvoices = !expandInvoices;
    private void HandleReportsClick() => expandReports = !expandReports;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        user = authState.User;
        isAdmin = user.IsInRole("Admin");
        isBusiness = user.IsInRole("Business");
        isUser = user.IsInRole("User");
    }
}