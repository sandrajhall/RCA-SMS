@using RCA_StudyManagementSystem.Shared.Layout
@page "/app/uncreximports/importpdf/{Token}"

@layout NullLayout
<style>
    html,
    body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
    }

    .pdf-frame-wrapper {
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

    .pdf-frame {
        display: block;
        width: 100%;
        height: 100%;
        min-height: 100vh;
        border: 0;
        overflow: auto;
    }
</style>

<div class="pdf-frame-wrapper">
    <iframe src="@($"/app/uncreximports/view/{Uri.EscapeDataString(Token)}")"
            class="pdf-frame"
            title="UNC Affiliates Import PDF View">
    </iframe>
</div>

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;
}