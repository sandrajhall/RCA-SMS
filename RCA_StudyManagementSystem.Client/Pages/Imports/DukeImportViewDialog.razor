@using MudBlazor
@using RCA_StudyManagementSystem.Client.Services
@using RCA_StudyManagementSystem.Shared.Domain
@using RCA_StudyManagementSystem.Client.Pages.Cases
@using RCA_StudyManagementSystem.Client.Interfaces

@rendermode InteractiveAuto

@inject IDialogService DialogService
@inject IStudyData StudyData
@inject IHospitalData HospitalData


<style>
    .report-card {
        max-width: 1400px;
        margin: auto;
    }

    .section-title {
        color: #174a7c;
        font-weight: 600;
        margin-bottom: 12px;
    }
</style>

<MudDialog>
    <DialogContent>

        <MudPagination Color="Color.Primary" ShowFirstButton="true" ShowLastButton="true"
                       Count="@totalPages"
                       Selected="@currPage"
                       SelectedChanged="OnPageChanged"
                       Class="mt-4 d-flex justify-end" Style="position: fixed; top: 20px; right: 40px; z-index: 1500" />

        <div style=" height:900px; ">

            <PageTitle>Duke</PageTitle>

           
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

                <MudStack Row="true"
                          Justify="Justify.SpaceBetween"
                          AlignItems="AlignItems.Center"
                          Class="mb-4">

                    <MudText Typo="Typo.h5">
                        Duke Pathology Report
                    </MudText>

                    
                    <MudText Typo="Typo.h5">
                        Study: @Model.Study
                    </MudText>

                </MudStack>

                <MudPaper Class="pa-4">

                    <MudText Typo="Typo.h6" Class="section-title">
                        Patient Information
                    </MudText>

                    <MudGrid Spacing="2">

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Medical Record Number"
                                          Value="@Display(Model.MedicalRecordNumber)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Last Name"
                                          Value="@Display(Model.LastName)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="First Name"
                                          Value="@Display(Model.FirstName)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Middle Name"
                                          Value="@Display(Model.MiddleName)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Date of Birth"
                                          Value="@FormatDate(Model.DateOfBirth)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Sex"
                                          Value="@Display(Model.Sex)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Social Security Number"
                                          Value="@Display(Model.SocialSecurityNumber)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Address"
                                          Value="@Display(Model.CurrentAddress)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="City"
                                          Value="@Display(Model.CurrentCity)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="1">
                            <MudTextField Label="State"
                                          Value="@Display(Model.DiagnosisState)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="2">
                            <MudTextField Label="Postal Code"
                                          Value="@Display(Model.CurrentPostalCode)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Race"
                                          Value="@Display(Model.Race1)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Marital Status at Diagnosis"
                                          Value="@Display(Model.MaritalStatusAtDiagnosis)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Telephone"
                                          Value="@Display(Model.Telephone)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                    </MudGrid>

                    <MudDivider Class="my-5" />

                    <MudText Typo="Typo.h6" Class="section-title">
                        Pathology Information
                    </MudText>

                    <MudGrid Spacing="2">

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Path Report Number / ID"
                                          Value="@Display(Model.PathReportNumberId)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Collected Date"
                                          Value="@FormatDate(Model.PathReportCollectedDate)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Ordering Location"
                                          Value="@Display(Model.PathReportOrderingLocation)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Authorizing Provider"
                                          Value="@Display(Model.PathReportAuthorizingProvider)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Pathologist"
                                          Value="@Display(Model.PathReportPathologist)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Final Diagnosis"
                                          Value="@Display(Model.PathReportFinalDiagnosis)"
                                          ReadOnly="true"
                                          Lines="8"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Comment"
                                          Value="@Display(Model.PathReportComment)"
                                          ReadOnly="true"
                                          Lines="5"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Clinical History"
                                          Value="@Display(Model.PathReportClinicalHistory)"
                                          ReadOnly="true"
                                          Lines="6"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Microscopic Description"
                                          Value="@Display(Model.PathReportMicroscopicDescription)"
                                          ReadOnly="true"
                                          Lines="8"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                    </MudGrid>

                    <MudDivider Class="my-5" />

                    <MudText Typo="Typo.h6" Class="section-title">
                        Addenda
                    </MudText>

                    <MudGrid Spacing="2">

                        <MudItem xs="12">
                            <MudTextField Label="Addendum 1"
                                          Value="@Display(Model.Addendum1)"
                                          ReadOnly="true"
                                          Lines="4"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Addendum 2"
                                          Value="@Display(Model.Addendum2)"
                                          ReadOnly="true"
                                          Lines="4"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Addendum 3"
                                          Value="@Display(Model.Addendum3)"
                                          ReadOnly="true"
                                          Lines="4"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Addendum 4"
                                          Value="@Display(Model.Addendum4)"
                                          ReadOnly="true"
                                          Lines="4"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Addendum 5"
                                          Value="@Display(Model.Addendum5)"
                                          ReadOnly="true"
                                          Lines="4"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                    </MudGrid>

                </MudPaper>

            </MudContainer>
        </div>
    </DialogContent>

</MudDialog>