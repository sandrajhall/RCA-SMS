@attribute [Authorize]
@page "/app/uncaffiliatesimport/list"

@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using RCA_StudyManagementSystem.Shared.Domain
@using RCA_StudyManagementSystem.Client.Services
@using RCA_StudyManagementSystem.Shared.ViewModels
@using RCA_StudyManagementSystem.Shared.ImportViews
@using RCA_StudyManagementSystem.Client.Stores
@using MudBlazor

@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject GridStateView<UNCAffiliatesImportView> ImportGridStateView
@inject ILocalStorageService LocalStorage
@inject UNCAffiliatesPdfStore PdfStore
@inject ISnackbar Snackbar

@rendermode InteractiveAuto


<MudDataGrid T="UNCAffiliatesImportView" @ref="importGrid" Items="@_displayItems" SortMode="SortMode.Single" Filterable="true"
             QuickFilter="@_quickFilter" Dense
             FilterDefinitions="@ImportGridStateView.FilterDefinitions"
             SortDefinitions="@ImportGridStateView.SortDefinitions"
             CurrentPage="@ImportGridStateView.CurrentPage"
             CurrentPageChanged=@((currentPage) => OnCurrentPageChanged(currentPage))
             FilterMode="DataGridFilterMode.ColumnFilterRow" AllowUnsorted="false" FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive">
    <ToolBarContent>
        <MudText Typo="Typo.h6">UNC Affiliates Imports</MudText>
        <div style="width: 200px;" class="ml-6">
            <MudSelect T="string"
                       Value="SelectedHospital"
                       Placeholder="Select Hospital"
                       Label=""
                       Dense="true"
                       ValueChanged="NameChanged">
                <MudSelectItem T="string" Value="@("Caldwell")">Caldwell</MudSelectItem>
                <MudSelectItem T="string" Value="@("Johnston")">Johnston</MudSelectItem>
                <MudSelectItem T="string" Value="@("Onslow")">Onslow</MudSelectItem>
                <MudSelectItem T="string" Value="@("Rex")">Rex</MudSelectItem>
                <MudSelectItem T="string" Value="@("Rockingham")">Rockingham</MudSelectItem>
            </MudSelect>
        </div>
        <MudSpacer />
        <InputFile id="fileInput" OnChange="Import" hidden />

        <label for="fileInput"
               class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-small mud-ripple ml-2"
               style="display: inline-flex; align-items: center; cursor: pointer;">
            Upload File
        </label> @*        <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true" TextUpdateSuppression="false"
                                AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Clearable="true"></MudTextField> *@
    </ToolBarContent>
    <ColGroup>
    </ColGroup>
    <Columns>

        <PropertyColumn Property="x => x.PAT_ID" Title="ID" Filterable="false" />
        <PropertyColumn Property="x => x.PAT_LAST_NAME" Title="Last Name" Filterable="false" />
        <PropertyColumn Property="x => x.PAT_FIRST_NAME" Title="First Name" Filterable="false" />
        <PropertyColumn Property="x => x.CITY" Title="City" Filterable="false" />
        <PropertyColumn Property="x => x.Study" Title="Study" Filterable="false" />

        <TemplateColumn HeaderText="Actions">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.ContactPage" OnClick=@(() => ViewItem(context.Item, context.Item)) Variant="Variant.Text" Color="Color.Primary">View</MudIconButton>
               @if (!string.IsNullOrWhiteSpace(context.Item.PAT_ID) &&
     PdfTokens.TryGetValue(context.Item.PAT_ID, out var pdfToken))
{
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.PictureAsPdf" Href="@($"/app/uncaffiliatesimports/importpdf/{pdfToken}")" Target="_blank" Variant="Variant.Text" Color="Color.Primary">PDF</MudIconButton>
}
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="UNCAffiliatesImportView" />
    </PagerContent>
</MudDataGrid>
@* <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"  OnClick="OnImport">Import Hospitals</MudButton>
 *@
