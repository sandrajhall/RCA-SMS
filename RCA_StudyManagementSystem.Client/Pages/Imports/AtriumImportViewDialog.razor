@using MudBlazor
@using RCA_StudyManagementSystem.Client.Services
@using RCA_StudyManagementSystem.Shared.Domain
@using RCA_StudyManagementSystem.Client.Pages.Cases
@using RCA_StudyManagementSystem.Client.Interfaces

@rendermode InteractiveAuto

@inject IDialogService DialogService
@inject IStudyData StudyData
@inject IHospitalData HospitalData

<MudDialog>
    <DialogContent>

        <MudPagination Color="Color.Primary" ShowFirstButton="true" ShowLastButton="true"
                       Count="@totalPages"
                       Selected="@currPage"
                       SelectedChanged="OnPageChanged"
                       Class="mt-4 d-flex justify-end" Style="position: fixed; top: 20px; right: 40px; z-index: 1500" />

        <div style=" height:900px; ">

            <PageTitle>UNC @Model.HospitalName</PageTitle>

            <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

                <MudStack Row="true"
                          Justify="Justify.SpaceBetween"
                          AlignItems="AlignItems.Center"
                          Class="mb-4">

                    <MudText Typo="Typo.h5">
                        @Model.HospitalName
                    </MudText>

            
                    <MudText Typo="Typo.subtitle1">
                        Study: @Display(Model.Study)
                    </MudText>

                </MudStack>

                <MudPaper Class="pa-4">

                    <MudText Typo="Typo.h6" Class="section-title">
                        Patient Information
                    </MudText>

                    <MudGrid Spacing="2">

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Facility"
                                          Value="@Display(Model.Facility_Name)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="MRN"
                                          Value="@Display(Model.MRN)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Requisition ID"
                                          Value="@Display(Model.Requisition_ID)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Last Name"
                                          Value="@Display(Model.Last_Name)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="First Name"
                                          Value="@Display(Model.First_Name)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Middle Name"
                                          Value="@Display(Model.Middle_Name)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Date of Birth"
                                          Value="@FormatDate(Model.DOB)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="SSN"
                                          Value="@Display(Model.SSN)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Gender"
                                          Value="@Display(Model.Gender)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Race"
                                          Value="@Display(Model.PatientRace)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Ethnicity"
                                          Value="@Display(Model.Ethnicity)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Language"
                                          Value="@Display(Model.Language)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Marital Status"
                                          Value="@Display(Model.MaritalStatus)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                    </MudGrid>

                    <MudDivider Class="my-5" />

                    <MudText Typo="Typo.h6" Class="section-title">
                        Contact Information
                    </MudText>

                    <MudGrid Spacing="2">

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Address Line 1"
                                          Value="@Display(Model.Address_Line1)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Address Line 2"
                                          Value="@Display(Model.Address_Line2)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="City"
                                          Value="@Display(Model.City)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="2">
                            <MudTextField Label="State"
                                          Value="@Display(Model.State)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="2">
                            <MudTextField Label="ZIP"
                                          Value="@Display(Model.Zip)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Email"
                                          Value="@Display(Model.Email)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Home Phone"
                                          Value="@Display(Model.Phone_Number_Home)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Mobile Phone"
                                          Value="@Display(Model.Phone_Number_Mobile)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                    </MudGrid>

                    <MudDivider Class="my-5" />

                    <MudText Typo="Typo.h6" Class="section-title">
                        Case and Specimen Information
                    </MudText>

                    <MudGrid Spacing="2">

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Specimen Source"
                                          Value="@Display(Model.SpecimenSource)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Pathology Report Number"
                                          Value="@Display(Model.Path_Report_Number)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Date Collected"
                                          Value="@FormatDate(Model.Date_Collected)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Lab Name"
                                          Value="@Display(Model.Lab_Name)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Authorizing Provider"
                                          Value="@Display(Model.Authorizing_Provider)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Pathologist"
                                          Value="@Display(Model.Pathologist)"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                    </MudGrid>

                    <MudDivider Class="my-5" />

                    <MudText Typo="Typo.h6" Class="section-title">
                        Diagnosis and Report Information
                    </MudText>

                    <MudGrid Spacing="2">

                        <MudItem xs="12">
                            <MudTextField Label="Final Diagnosis"
                                          Value="@Display(Model.Final_Diagnosis)"
                                          ReadOnly="true"
                                          Lines="8"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Diagnostic Comments"
                                          Value="@Display(Model.Dx_Comments)"
                                          ReadOnly="true"
                                          Lines="5"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Addendums"
                                          Value="@Display(Model.Addendums)"
                                          ReadOnly="true"
                                          Lines="5"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Clinical History"
                                          Value="@Display(Model.Clinical_History)"
                                          ReadOnly="true"
                                          Lines="6"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Gross Description"
                                          Value="@Display(Model.Gross_Description)"
                                          ReadOnly="true"
                                          Lines="8"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Synoptic Report"
                                          Value="@Display(Model.SynopticReport)"
                                          ReadOnly="true"
                                          Lines="8"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                    </MudGrid>

                </MudPaper>

            </MudContainer>
        </div>
    </DialogContent>

</MudDialog>